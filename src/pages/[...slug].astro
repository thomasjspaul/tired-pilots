---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LastReviewed from '../components/LastReviewed.astro';
import SuggestCorrection from '../components/SuggestCorrection.astro';
import DataTable from '../components/DataTable.astro';
import FdpTables from '../components/FdpTables.astro';
import AugmentedCrewTable from '../components/AugmentedCrewTable.astro';
import RecentlyUpdated from '../components/RecentlyUpdated.astro';

export async function getStaticPaths() {
  const entries = await getCollection('pages', (e) => {
    if (e.data.lang !== 'en') return false;
    return import.meta.env.PROD ? !e.data.draft : true;
  });
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const mdxComponents = { DataTable, FdpTables, AugmentedCrewTable, RecentlyUpdated };
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="container page">
    <article class="prose">
      <h1>{entry.data.title}</h1>
      <Content components={mdxComponents} />
    </article>
    <footer class="page__foot">
      <LastReviewed date={entry.data.lastReviewed} by={entry.data.reviewedBy} />
      <SuggestCorrection pageTitle={entry.data.title} />
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 2.25rem 1rem;
    max-width: var(--measure);
  }
  .page__foot {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 0.5rem;
  }
</style>
