---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IncreasedRestFlowchart from '../../islands/IncreasedRestFlowchart.tsx';
---

<BaseLayout
  title="Increased rest — which rule applies"
  description="A clickable version of the Advisory Circular 700-047 Appendix A flowchart: after a flight duty period is extended, which provision sets the rest period."
>
  <div class="container fc-page">
    <p class="fc-page__eyebrow">AC 700-047 · Appendix A</p>
    <h1>Increased rest — which rule applies</h1>
    <p class="fc-page__lede">
      When a flight duty period is extended, one of several provisions sets the rest period that
      follows. Answer the questions to find which one — then read the full rule.
    </p>

    <IncreasedRestFlowchart client:load />

    <p class="fc-page__back"><a href="/rules/700-40">&larr; Rest periods (700.40)</a></p>
  </div>
</BaseLayout>

<style>
  .fc-page {
    padding-block: 2.25rem 1rem;
    max-width: 40rem;
  }
  .fc-page__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
    margin: 0 0 0.35rem;
  }
  .fc-page h1 {
    margin: 0 0 0.5rem;
  }
  .fc-page__lede {
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
  }
  .fc-page__back {
    margin-top: 1.5rem;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }
</style>
