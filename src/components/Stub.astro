---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props {
  title: string;
  stage: string;
}
const { title, stage } = Astro.props;
---

<BaseLayout
  title={title}
  description={`${title} — coming in ${stage} of the tiredpilots.ca rebuild.`}
  noindex
>
  <section class="container" style="padding-block: 3rem;">
    <h1>{title}</h1>
    <p style="font-family: var(--font-ui); color: var(--ink-soft);">
      Placeholder. This page is built in <strong>{stage}</strong> of the rebuild. The skeleton, navigation
      and design directions are what's under review right now — see
      <a href="/style-preview">/style-preview</a>.
    </p>
    <slot />
    <p><a href="/">&larr; Back to the home page</a></p>
  </section>
</BaseLayout>
