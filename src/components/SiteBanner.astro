---
/**
 * Temporary "we've moved" announcement strip, shown at the very top of every
 * page. Sits in normal flow (scrolls away above the sticky header). Dismissible
 * per browser via localStorage. Remove this component and its import in
 * BaseLayout.astro once the migration settles.
 */
import { getEntry } from 'astro:content';

const settings = await getEntry('settings', 'site');
const email = settings?.data.contactEmail ?? 'corrections@tiredpilots.ca';
---

<div id="site-banner" class="banner" role="region" aria-label="Site announcement">
  <div class="container container--wide banner__inner">
    <p class="banner__text">
      <strong>We&rsquo;ve moved.</strong> tiredpilots.ca has a new home with search, an FDP calculator
      and clearer rule pages. We&rsquo;re still reviewing the migrated content &mdash; if something looks
      wrong, email{' '}
      <a href={`mailto:${email}?subject=${encodeURIComponent('[tiredpilots.ca] Correction')}`}>
        {email}
      </a>.
    </p>
    <button
      type="button"
      id="site-banner-dismiss"
      class="banner__close"
      aria-label="Dismiss announcement"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18">
        <path
          fill="currentColor"
          d="m18.3 5.7-1.4-1.4L12 9.2 7.1 4.3 5.7 5.7 10.6 10.6 5.7 15.5l1.4 1.4L12 12l4.9 4.9 1.4-1.4L13.4 10.6z"
        ></path>
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'tp-newsite-banner-v1';
    var el = document.getElementById('site-banner');
    if (!el) return;
    try {
      if (localStorage.getItem(KEY) === '1') {
        el.hidden = true;
        return;
      }
    } catch (e) {
      /* storage blocked — leave the banner visible, dismissal just won't persist */
    }
    var btn = document.getElementById('site-banner-dismiss');
    if (btn)
      btn.addEventListener('click', function () {
        el.hidden = true;
        try {
          localStorage.setItem(KEY, '1');
        } catch (e) {}
      });
  })();
</script>

<style>
  .banner {
    background: var(--accent-soft);
    border-bottom: 2px solid var(--accent);
    font-family: var(--font-ui);
  }
  .banner__inner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem 1rem;
    padding-block: 0.55rem;
  }
  .banner__text {
    margin: 0;
    flex: 1 1 auto;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink);
  }
  .banner__text a {
    color: var(--accent-strong);
    font-weight: 600;
    text-decoration: underline;
    word-break: break-word;
  }
  .banner__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    margin: -0.15rem -0.35rem -0.15rem 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .banner__close:hover {
    background: rgba(20, 32, 43, 0.08);
    color: var(--ink);
  }
  .banner__close:focus-visible {
    outline: 0;
    box-shadow: var(--focus);
  }
</style>
