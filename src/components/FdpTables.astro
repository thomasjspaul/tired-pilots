---
/**
 * The four CARs 700.28 maximum-FDP lookup tables, rendered from src/data/fdp.ts
 * (the same data the calculator uses). Replaces the flat JPGs from the old site.
 */
import {
  DAY_VFR_CITATION,
  DAY_VFR_FDP,
  DURATION_BUCKET_LABEL,
  FDP_CITATION,
  FDP_TABLE,
  FLIGHT_BANDS,
  START_BANDS,
  hoursToHHMM,
  type AvgDurationBucket,
} from '../data/fdp';
import DataTable from './DataTable.astro';

const durationTables: AvgDurationBucket[] = ['lt30', '30to50', 'gte50'];
const fmt = (h: number) => hoursToHHMM(h);
---

<div class="fdp-tables">
  {
    durationTables.map((bucket) => (
      <DataTable
        title={`Maximum flight duty period — average flight duration ${DURATION_BUCKET_LABEL[bucket]}`}
        citation={FDP_CITATION[bucket]}
        columns={[
          'Start time of flight duty period',
          ...FLIGHT_BANDS[bucket].map((fb) => fb.label),
        ]}
        rows={START_BANDS.map((sb, r) => [sb.label, ...FDP_TABLE[bucket][r].map(fmt)])}
      />
    ))
  }

  <DataTable
    title="Maximum flight duty period — flights conducted under day VFR"
    citation={DAY_VFR_CITATION}
    columns={['Start time of flight duty period', 'Maximum flight duty period']}
    rows={START_BANDS.map((sb, r) => [sb.label, fmt(DAY_VFR_FDP[r])])}
  />

  <p class="fdp-tables__note">
    Times shown as <abbr title="hours:minutes">h:mm</abbr>. These tables assume an acclimatized
    flight crew member — see <a href="#acclimatization">acclimatization</a> below if you are not acclimatized
    to local time.
  </p>
</div>

<style>
  .fdp-tables {
    margin: 1.5rem 0;
  }
  .fdp-tables__note {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }
</style>
