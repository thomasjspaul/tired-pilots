{
  "name": "tired-pilots",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "tiredpilots.ca — a plain-language guide to Canada's flight-crew fatigue rules (CARs Subpart 700).",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node ./scripts/gen-redirects.mjs",
    "build": "astro build",
    "postbuild": "node ./scripts/build-search-vectors.mjs || true",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "verify:redirects": "node ./scripts/check-redirects.mjs",
    "verify:anchors": "node ./scripts/check-anchors.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/preact": "^4.1.0",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.1",
    "astro-pagefind": "^1.8.3",
    "preact": "^10.27.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "pagefind": "^1.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "^5.0.0"
  }
}
