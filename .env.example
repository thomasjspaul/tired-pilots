# Copy to `.env` for local development. NEVER put real secrets in `.env.example`,
# and NEVER commit `.env`. In production these are set in the Cloudflare Pages
# dashboard (Settings -> Variables), not here.

# Cloudflare Web Analytics beacon token (optional; Pages can auto-inject instead).
PUBLIC_CF_BEACON_TOKEN=

# Cohere API key. Powers three things, all server-side:
#   - the semantic-search index build (scripts/build-search-vectors.mjs)
#   - the /api/embed Pages Function (visitor search queries)
#   - the /api/rewrite Pages Function (the /rewrite editor tool — see
#     docs/EDITORIAL-ASSISTANT.md)
# Set it in Cloudflare Pages for BOTH Production and Preview.
COHERE_API_KEY=
