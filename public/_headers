# Cloudflare Pages headers. https://developers.cloudflare.com/pages/configuration/headers/
#
# A more specific path block overrides the same header from a less specific one,
# so /admin/* below replaces the site-wide Content-Security-Policy for the CMS.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; frame-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'self' blob:; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; upgrade-insecure-requests

# The CMS admin shell loads Sveltia from unpkg and talks to the GitHub API and
# the OAuth broker Worker. It is noindex and sign-in gated; only the site owner
# reaches it. Its script source is still pinned to unpkg and SRI-locked in
# /admin/index.html.
/admin/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' blob: data: https://unpkg.com https://api.github.com https://raw.githubusercontent.com https://*.githubusercontent.com https://tiredpilots-cms-auth.thomasjspaul.workers.dev

# Long-cache fingerprinted build assets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400
